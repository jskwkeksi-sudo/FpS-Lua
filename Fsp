-- 4. ระบบ Potato Mode
local isPotatoOn = false
local function applyPotatoMode(enable)
    if enable then
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 9e9
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("BasePart") then
                v.Material = Enum.Material.SmoothPlastic
                v.CastShadow = false
            elseif v:IsA("Decal") or v:IsA("Texture") then
                v.Transparency = 1
            elseif v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Smoke") or v:IsA("Fire") then
                v.Enabled = false
            end
        end
    else
        Lighting.GlobalShadows = true
        Lighting.FogEnd = 10000
    end
end

toggleBtn.MouseButton1Click:Connect(function()
    isPotatoOn = not isPotatoOn
    if isPotatoOn then
        toggleBtn.Text = "🥔 Potato Mode: ON"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
        applyPotatoMode(true)
    else
        toggleBtn.Text = "🥔 Potato Mode: OFF"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        applyPotatoMode(false)
    end
end)

-- 5. ลูปอัปเดต FPS + เวลา
local frameCount = 0
local lastTick = tick()
local currentFPS = 0

local connection
connection = RunService.RenderStepped:Connect(function()
    if not screenGui.Parent then
        if connection then connection:Disconnect() end
        return
    end
    
    frameCount = frameCount + 1
    local now = tick()
    
    if now - lastTick >= 1 then
        currentFPS = math.floor(frameCount / (now - lastTick))
        frameCount = 0
        lastTick = now
    end
    
    local timeString = os.date("%H:%M:%S")
    textLabel.Text = string.format(" ⚡ FPS: %d\n 🕒 เวลา: %s", currentFPS, timeString)
end)
